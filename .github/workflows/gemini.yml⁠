name: Gemini CLI
on:
  issues:
    types: [opened]
  issue_comment:
    types: [created]

jobs:
  gemini:
    if: |
      (github.event_name == 'issues' && contains(github.event.issue.body, '@gemini-cli')) ||
      (github.event_name == 'issue_comment' && contains(github.event.comment.body, '@gemini-cli'))
    runs-on: ubuntu-latest
    permissions:
      contents: write
      issues: write
      pull-requests: write
    steps:
      - uses: actions/checkout@v4

      - id: run_gemini
        uses: google-github-actions/run-gemini-cli@v0
        with:
          gemini_api_key: ${{ secrets.GEMINI_API_KEY }}
          prompt: ${{ github.event.comment.body || github.event.issue.body }}

      - name: Publicar respuesta en el Issue
        uses: actions/github-script@v7
        with:
          script: |
            const summary = `${{ steps.run_gemini.outputs.summary }}`;
            await github.rest.issues.createComment({
              issue_number: context.issue.number,
              owner: context.repo.owner,
              repo: context.repo.repo,
              body: summary || 'Análisis completado (revisa el registro en Actions).'
            });
